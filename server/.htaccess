# GHOSTS 'N GOALS — regole per Apache (Serverplan)
Options -Indexes

# file di configurazione e librerie: mai accessibili dal web
<FilesMatch "^(config\.php|config\.sample\.php|composer\.(json|lock))$">
  Require all denied
</FilesMatch>
<FilesMatch "^_">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # i file del gioco hanno un nome che cambia a ogni versione: si possono tenere a lungo in cache
  <FilesMatch "\.(js|css|woff2?|png|ogg|mp3|m4a|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# forza HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
