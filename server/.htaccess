# GHOSTS 'N GOALS — regole per Apache (Serverplan)
Options -Indexes
AddType application/manifest+json .webmanifest
# la pagina d'ingresso decide tra gioco e volantino "MISSING" (manutenzione, dall'admin)
DirectoryIndex index.php index.html

# file di configurazione e librerie: mai accessibili dal web
<FilesMatch "^(config\.php|config\.sample\.php|composer\.(json|lock))$">
  Require all denied
</FilesMatch>
<FilesMatch "^_">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # i file del gioco hanno un nome che cambia a ogni versione: si possono tenere a lungo in cache
  <FilesMatch "\.(js|css|woff2?|png|ogg|mp3|m4a|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# forza HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On
  # un solo indirizzo per i motori di ricerca: www e il dominio senza "s" portano a ghostsngoals.com
  RewriteCond %{HTTP_HOST} ^(www\.)?ghostngoals\.com$ [NC,OR]
  RewriteCond %{HTTP_HOST} ^www\.ghostsngoals\.com$ [NC]
  RewriteRule ^ https://ghostsngoals.com%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # anche chi apre index.html direttamente passa dal controllo della manutenzione
  RewriteRule ^index\.html$ index.php [L]
</IfModule>
