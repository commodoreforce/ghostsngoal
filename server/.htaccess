# GHOSTS 'N GOALS — regole per Apache (Serverplan)
Options -Indexes
AddType application/manifest+json .webmanifest
AddType application/octet-stream .bin
# la pagina d'ingresso decide tra gioco e volantino "MISSING" (manutenzione, dall'admin)
DirectoryIndex index.php index.html

# file di configurazione e librerie: mai accessibili dal web
<FilesMatch "^(config\.php|config\.sample\.php|composer\.(json|lock))$">
  Require all denied
</FilesMatch>
<FilesMatch "^_">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # i file del gioco cambiano nome (assets/) o portano la versione nell'indirizzo (?v=, sprite,
  # sfondi e musica): si possono tenere in cache a lungo, ogni pubblicazione li fa riscaricare
  <FilesMatch "\.(js|css|woff2?|png|ogg|mp3|m4a|webp|bin)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # icone, anteprima dei link e manifest hanno sempre lo stesso indirizzo: un giorno al massimo
  <FilesMatch "^(favicon\.(png|ico)|icon-\d+\.png|apple-touch-icon\.png|og\.png|poster\.png|manifest\.webmanifest|robots\.txt|sitemap\.xml)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# compressione: il codice del gioco (1,5 MB) viaggia compresso a circa un quarto
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml text/plain application/xml text/xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml text/plain application/xml text/xml
</IfModule>

# forza HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On
  # un solo indirizzo per i motori di ricerca: www e il dominio senza "s" portano a ghostsngoals.com
  RewriteCond %{HTTP_HOST} ^(www\.)?ghostngoals\.com$ [NC,OR]
  RewriteCond %{HTTP_HOST} ^www\.ghostsngoals\.com$ [NC]
  RewriteRule ^ https://ghostsngoals.com%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # anche chi apre index.html direttamente passa dal controllo della manutenzione
  RewriteRule ^index\.html$ index.php [L]
</IfModule>
